{
    "configurations": [
        {
            "name": "DKP aarch64",
            "includePath": [
                "${workspaceFolder}/**",
                "/opt/devkitpro/libnx/include",
                "/opt/devkitpro/portlibs/switch/include",
                "/opt/devkitpro/devkitA64/aarch64-none-elf/include",
                "/opt/devkitpro/devkitA64/lib/gcc/aarch64-none-elf/16.1.0/include"
            ],
            "defines": [
                "SWITCH",
                "__SWITCH__",
                "__aarch64__"
            ],
            "compilerPath": "/opt/devkitpro/devkitA64/bin/aarch64-none-elf-g++",
            "compilerArgs": [
                "-march=armv8-a+crc+crypto",
                "-mtune=cortex-a57",
                "-mtp=soft",
                "-fPIE"
            ],
            "forcedInclude": [
                "${workspaceFolder}/.vscode/intellisense-switch.h"
            ],
            "cStandard": "gnu17",
            "cppStandard": "gnu++20",
            "intelliSenseMode": "linux-gcc-arm64"
        }
    ],
    "version": 4
}
